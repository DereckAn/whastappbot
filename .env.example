# WhatsApp
WHATSAPP_AUTH_DIR=/data/auth

# Downloads
DOWNLOADS_DIR=/data/downloads
GALLERY_DL_PATH=gallery-dl

# Google Drive (Optional)
GDRIVE_ENABLED=false
GDRIVE_OAUTH_CREDENTIALS_PATH=/data/credentials/oauth-credentials.json
GDRIVE_OAUTH_TOKEN_PATH=/data/credentials/oauth-token.json
GDRIVE_ROOT_FOLDER_ID=

# Monitored Groups (comma-separated)
MONITORED_GROUPS=

# Logging
LOG_LEVEL=info

# GitHub PAT (to download credentials from private repo)
GITHUB_TOKEN=

# Dashboard (127.0.0.1 = solo esta máquina; usa 0.0.0.0 en Docker)
UI_PORT=3000
UI_HOST=127.0.0.1
